      <column caption='Valeur dynamique' datatype='integer' name='[Calculation_1140536660254601216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Paramètre 1] = 1 THEN [Documents]&#13;&#10;ELSE [Citations]&#13;&#10;END' />
