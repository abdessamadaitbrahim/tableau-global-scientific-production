      <column caption='Indicateur visualisé' datatype='real' name='[Calculation_1140536660321021954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Paramètre 2] WHEN &quot;Documents&quot; THEN [Documents] WHEN &quot;Citations&quot; THEN [Citations] WHEN &quot;Citations par document&quot; THEN [Citations.per.Document] WHEN &quot;H-index&quot; THEN [H.index] WHEN &quot;Auto-citations&quot; THEN [Self.Citations] END' />
